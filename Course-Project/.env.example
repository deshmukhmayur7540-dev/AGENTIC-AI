# CourseAgentAI local configuration
# The application starts without any of these values.

COURSEAGENTAI_HOST=127.0.0.1
COURSEAGENTAI_PORT=8000
COURSEAGENTAI_DEBUG=true

# Browser login and unsafe requests require an exact trusted Origin.
# Match this to the origin and port used in the browser; never use a wildcard.
# COURSEAGENTAI_CORS_ORIGINS=http://127.0.0.1:8000

# Optional overrides. Defaults are local SQLite and the knowledge/ folder.
# DATABASE_PATH=app/data/governed_academic.db
# KNOWLEDGE_ROOT=knowledge

# Optional Lab 4 local embedding model; download explicitly with the documented setup command.
# COURSEAGENTAI_LAB4_EMBEDDING_MODEL_PATH=models/lab4/all-MiniLM-L6-v2
# COURSEAGENTAI_LAB4_EMBEDDING_SIMILARITY_THRESHOLD=0.25

# Optional. Not required for startup or the eight labs.
# LLM_PROVIDER=deterministic
# GITHUB_TOKEN=
# GEMINI_API_KEY=
# OPENAI_API_KEY=
